---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
  {%- assign ext = p.name | split: "." | last %}
  {%- if p.sitemap == false or p.url contains "/assets/" or p.url == "/404.html" %}{% continue %}{% endif %}
  {%- unless ext == "md" or ext == "html" or ext == "markdown" %}{% continue %}{% endunless %}
  <url><loc>{{ site.url }}{{ p.url | replace: "index.html", "" | xml_escape }}</loc></url>
{%- endfor %}
{%- for p in site.posts %}
  {%- if p.sitemap == false %}{% continue %}{% endif %}
  <url><loc>{{ site.url }}{{ p.url | xml_escape }}</loc><lastmod>{{ p.date | date_to_xmlschema }}</lastmod></url>
{%- endfor %}
</urlset>
